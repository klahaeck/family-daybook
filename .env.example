# Application
# Production and preview deployments must use https://www.myfamilydaybook.com.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Private support delivery and abuse prevention
RESEND_API_KEY=re_REPLACE_ME
SUPPORT_TO_EMAIL=REPLACE_WITH_PRIVATE_DESTINATION
SUPPORT_FROM_EMAIL=REPLACE_WITH_VERIFIED_SENDER
NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE_ME
TURNSTILE_SECRET_KEY=REPLACE_ME

# Search and agent directory verification
INDEXNOW_KEY=REPLACE_WITH_8_TO_128_CHARACTER_KEY
OPENAI_APPS_CHALLENGE_TOKEN=REPLACE_WITH_PORTAL_TOKEN

# MongoDB Atlas
MONGODB_URI=mongodb+srv://APPLICATION_USER:STRONG_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=parenting_log

# Clerk invitation-only authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app
# Comma-separated paid Clerk user Plan slugs accepted for workspace access.
# The hidden default Free plan is intentionally excluded.
CLERK_ALLOWED_PLAN_SLUGS=general
# Clerk Billing webhook endpoint: /api/webhooks/clerk/billing
CLERK_WEBHOOK_SIGNING_SECRET=whsec_REPLACE_ME
# Enable the authenticated mobile REST API in production deployments.
MOBILE_API_ENABLED=true
# Optional semver floor and maintenance switch returned during mobile bootstrap.
MOBILE_MINIMUM_SUPPORTED_VERSION=1.0.0
MOBILE_API_MAINTENANCE=false
# US Google Play external-content-link program. Keep disabled until enrollment,
# the required native Play integration, and transaction reporting are approved.
GOOGLE_PLAY_EXTERNAL_CONTENT_LINKS_ENABLED=false
# Base64-encoded 32-byte key used only when Google's external-link flow is enabled.
GOOGLE_PLAY_EXTERNAL_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# Universal-link association values. Set these from the final Apple Developer
# team and Android release signing certificate before shipping the mobile apps.
APPLE_APP_TEAM_ID=REPLACE_WITH_APPLE_TEAM_ID
ANDROID_APP_SHA256_CERT_FINGERPRINTS=REPLACE_WITH_RELEASE_CERT_SHA256
# MCP uses the same Clerk instance. Create these custom OAuth scopes in Clerk:
# daybook:read, daybook:write, daybook:finalize
# No separate MCP secret is used; access is granted by Clerk OAuth tokens.

# Vercel Private Blob — configure either a token or OIDC/store pair
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE_ME
# BLOB_STORE_ID=store_REPLACE_ME
# VERCEL_OIDC_TOKEN is supplied automatically by Vercel when OIDC is enabled.
# Presigned mobile uploads require verified completion callbacks. Configure the
# Ed25519 public key used by Vercel Blob to sign those callbacks. Override the
# callback URL for environments without Vercel system URL variables.
BLOB_WEBHOOK_PUBLIC_KEY=REPLACE_WITH_VERCEL_BLOB_WEBHOOK_PUBLIC_KEY
# VERCEL_BLOB_CALLBACK_URL=https://preview.example.com/api/attachments/upload-completed

# Optional integration-test database; never point this at production
TEST_MONGODB_URI=mongodb://127.0.0.1:27017
