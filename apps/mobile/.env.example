# Public values are embedded in the mobile bundle. Never put secrets here.
# Use a LAN-reachable origin instead of localhost on a physical device.
APP_ENV=development
EXPO_PUBLIC_API_ORIGIN=http://localhost:3000
EXPO_PUBLIC_WEB_ORIGIN=http://localhost:3000
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
EXPO_PUBLIC_EAS_PROJECT_ID=
# Leave blank for unsigned Simulator builds. Set the Apple Developer Team ID
# for physical-device and release builds to enable Apple Sign-In/app links.
APPLE_APP_TEAM_ID=
